{
  "name": "dsh-clinepass",
  "version": "0.6.0",
  "description": "Cline Pass for DeepSeek Harness: an OpenAI-compatible provider route whose requests are pinned to the DeepSeek upstream channel, with the API key entered on Settings → Models.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "install.mjs",
    "uninstall.mjs",
    "smoke-test.mjs",
    "test-fetch.mjs",
    "test-settings.mjs",
    "test-install.mjs",
    "patch.example.yml",
    "test-package.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "patch-file.mjs"
  ],
  "scripts": {
    "test": "node test-package.mjs && node test-fetch.mjs && node test-settings.mjs && node test-install.mjs",
    "test:package": "node test-package.mjs",
    "test:fetch": "node test-fetch.mjs",
    "test:settings": "node test-settings.mjs",
    "test:install": "node test-install.mjs",
    "smoke": "node smoke-test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cline",
    "cline-pass",
    "provider",
    "plugin",
    "deepseek"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BreakFree003/dsh-clinepass-deepseekv4.1.git"
  },
  "homepage": "https://github.com/BreakFree003/dsh-clinepass-deepseekv4.1#readme",
  "bugs": {
    "url": "https://github.com/BreakFree003/dsh-clinepass-deepseekv4.1/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
